generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                      Int         @id             @default(autoincrement())
  nome_usuario            String      @unique 
  nome_exibicao           String
  email                   String      @unique
  senha                   String
  data_nascimento         DateTime
  numero_celular          String
  foto_url                String?
  reputacao               Float       @default(0)
  cargo                   Role        @default(USER)
  banido                  Boolean     @default(false)
  bloqueado               Boolean     @default(false)
  bloqueado_ate           DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  deletedAt               DateTime?

  reviews         Review[]
  trilhas         Trilha[]
  reviews_favoritas       Review_favorita[]
  denuncias       Denuncia[]
  tokens          Token_redefinicao_senha[]
  tokens_email    Token_alteracao_email[]
  refresh_tokens  Token_refresh[]
  interacoes      Voto_review[]
}

model Review {
  id              Int         @id             @default(autoincrement())
  id_usuario      Int
  id_local        String
  local           String
  qnt_likes       Int         @default(0)
  qnt_dislikes    Int         @default(0)
  qnt_denuncia    Int         @default(0)
  qnt_favoritos   Int         @default(0)
  oculto          Boolean     @default(false)
  nota            Int         @default(0)
  descricao       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  
  autor       Usuario    @relation(fields: [id_usuario], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // "local" is the name typed when the review was made, the details live in Local.
  lugar       Local      @relation(fields: [id_local], references: [place_id], onDelete: Restrict, onUpdate: Cascade)
  denuncias   Denuncia[]
  
  fotos       Foto[]
  tags        Tag_review[]
  interacoes  Voto_review[]
  favoritas   Review_favorita[]

  @@index([id_usuario])
  @@index([id_local])
}

model Voto_review {
  id              Int         @id             @default(autoincrement())
  id_usuario      Int
  id_review       Int
  tipo            Tipo_voto
  
  createdAt       DateTime                    @default(now())
  updateAt        DateTime    @updatedAt

  usuario     Usuario     @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  review      Review      @relation(fields: [id_review], references: [id], onDelete: Cascade)

  @@unique([id_usuario, id_review])
  @@index([id_usuario])
  @@index([id_review])
}

model Review_favorita {
  id          Int         @id         @default(autoincrement())
  id_usuario          Int
  id_review         Int

  createdAt         DateTime          @default(now())

  usuario         Usuario         @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  review          Review          @relation(fields: [id_review], references: [id], onDelete: Cascade)

  @@unique([id_usuario, id_review])
  @@index([id_usuario])
  @@index([id_review])
}

model Foto {
  id              Int         @id             @default(autoincrement())
  url             String
  id_review       Int        
  createdAt       DateTime    @default(now())
  review          Review      @relation(fields: [id_review], references: [id], onDelete: Cascade)

  @@index([id_review])
}

model Tag {
  id              Int         @id             @default(autoincrement())
  descritivo      String      @unique
  createdAt       DateTime                    @default(now())

  em_reviews      Tag_review[]
  em_trilhas      Tag_trilha[]
}

// Google Places details of the places of reviews and trails (RF7). Saved when the first
// review or trail of the place is created, so the Places API is called once per place.
model Local {
  place_id        String      @id
  nome            String
  cidade          String?
  estado          String?
  sigla_estado    String?
  pais            String?
  sigla_pais      String?
  // The place itself is a city, so the card doesn't repeat the city name.
  is_cidade       Boolean     @default(false)
  endereco        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  reviews         Review[]
  trilhas         Trilha[]
}

model Tag_review {
  id              Int         @id             @default(autoincrement())
  id_review       Int
  id_tag          Int

  review          Review      @relation(fields: [id_review], references: [id], onDelete: Cascade)
  tag             Tag         @relation(fields: [id_tag], references: [id], onDelete: Cascade)
}


// Trail recorded in the app (RF24-RF30). "rota" holds the GPS path as a list of
// segments, one per tracking session between pauses: [[[lat, lng], ...], ...].
model Trilha {
  id              Int         @id             @default(autoincrement())
  id_usuario      Int
  // Optional only for the trails recorded before places were linked.
  id_local        String?
  nome            String
  cidade          String?
  estado          String?
  distancia_m     Float
  passos          Int
  duracao_s       Int
  nota            Int
  descricao       String
  rota            Json
  compartilhada   Boolean     @default(false)
  iniciada_em     DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  autor           Usuario     @relation(fields: [id_usuario], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lugar           Local?      @relation(fields: [id_local], references: [place_id], onDelete: Restrict, onUpdate: Cascade)
  fotos           Foto_trilha[]
  tags            Tag_trilha[]

  @@index([id_usuario])
  @@index([id_local])
  @@index([compartilhada])
}

model Foto_trilha {
  id              Int         @id             @default(autoincrement())
  url             String
  id_trilha       Int
  createdAt       DateTime    @default(now())
  trilha          Trilha      @relation(fields: [id_trilha], references: [id], onDelete: Cascade)

  @@index([id_trilha])
}

model Tag_trilha {
  id              Int         @id             @default(autoincrement())
  id_trilha       Int
  id_tag          Int

  trilha          Trilha      @relation(fields: [id_trilha], references: [id], onDelete: Cascade)
  tag             Tag         @relation(fields: [id_tag], references: [id], onDelete: Cascade)

  @@index([id_trilha])
}

model Token_redefinicao_senha {
  id            Int         @id             @default(autoincrement())
  token         String
  expira_em     DateTime
  usuario       Usuario     @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  id_usuario    Int
  
  @@index([id_usuario])
}

model Token_alteracao_email {
  id            Int         @id             @default(autoincrement())
  token         String
  novo_email    String
  expira_em     DateTime
  usuario       Usuario     @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  id_usuario    Int

  @@index([id_usuario])
}

model Denuncia {
  id         Int        @id            @default(autoincrement())
  descricao  String
  createdAt  DateTime   @default(now())

  autor      Usuario    @relation(fields: [id_usuario], references: [id], onDelete: Cascade, onUpdate: Cascade)
  id_usuario Int

  review     Review     @relation(fields: [id_review], references: [id], onDelete: Cascade, onUpdate: Cascade)
  id_review  Int

  @@unique([id_usuario, id_review])
}

model Token_refresh {
  id          Int      @id @default(autoincrement())
  token_hash  String   @unique
  expira_em   DateTime
  usuario     Usuario  @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  id_usuario  Int

  @@index([id_usuario])
}

enum Role {
  USER
  ADM
}

enum Tipo_voto {
  LIKE
  DISLIKE
}