generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                      Int         @id             @default(autoincrement())
  nome_usuario            String      @unique 
  nome_exibicao           String
  email                   String      @unique
  senha                   String
  data_nascimento         DateTime
  numero_celular          String
  foto_url                String?
  reputacao               Float       @default(0)
  cargo                   Role        @default(USER)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  // parte estrangeira.
  reviews         Review[]
  denuncias       Denuncia[]
  tokens          Token_redefinicao_senha[]
}

model Review {
  id              Int         @id             @default(autoincrement())
  id_usuario      Int
  id_local        String      // vi que o place id da API do google retorna sempre string.
  qnt_likes       Int         @default(0)
  qnt_dislikes    Int         @default(0)
  qnt_denuncia    Int         @default(0)
  oculto          Boolean     @default(false)
  nota            Int         @default(0)         
  descricao       String
  foto_url        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // chaves estrangeiras:
  // navegação.
  autor       Usuario    @relation(fields: [id_usuario], references: [id], onDelete: Restrict, onUpdate: Cascade) 
  denuncias   Denuncia[]
  
  // melhorar a busca.
  @@index([id_usuario])
  @@index([id_local])
}

model Token_redefinicao_senha {
  id            String    @id
  expira_em     String
  
  usuario       Usuario   @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  id_usuario    Int
  
  @@index([id_usuario])
}

model Denuncia {
  id         Int        @id            @default(autoincrement())
  descricao  String
  createdAt  DateTime   @default(now())

  // fksssss
  autor      Usuario    @relation(fields: [id_usuario], references: [id], onDelete: Cascade, onUpdate: Cascade)
  id_usuario Int

  review     Review     @relation(fields: [id_review], references: [id], onDelete: Cascade, onUpdate: Cascade)
  id_review  Int

  // usuário nao pode denunciar mesma coisa duas vezes.
  @@unique([id_usuario, id_review])
}

enum Role {
  USER
  ADM
}