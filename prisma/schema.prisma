generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                      Int         @id             @default(autoincrement())
  nome_usuario            String      @unique 
  nome_exibicao           String
  email                   String      @unique
  senha                   String
  data_nascimento         DateTime
  numero_celular          String
  foto_url                String?
  reputacao               Float       @default(0)
  cargo                   Role        @default(USER)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  deletedAt               DateTime?

  reviews         Review[]
  denuncias       Denuncia[]
  tokens          Token_redefinicao_senha[]
  refresh_tokens  Token_refresh[]
  interacoes      Voto_review[]
}

model Review {
  id              Int         @id             @default(autoincrement())
  id_usuario      Int
  id_local        String
  local           String
  qnt_likes       Int         @default(0)
  qnt_dislikes    Int         @default(0)
  qnt_denuncia    Int         @default(0)
  oculto          Boolean     @default(false)
  nota            Int         @default(0)
  descricao       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  autor       Usuario    @relation(fields: [id_usuario], references: [id], onDelete: Restrict, onUpdate: Cascade) 
  denuncias   Denuncia[]
  
  fotos       Foto[]
  tags        Tag_review[]
  interacoes  Voto_review[]

  @@index([id_usuario])
  @@index([id_local])
}

model Voto_review {
  id              Int         @id             @default(autoincrement())
  id_usuario      Int
  id_review       Int
  tipo            Tipo_voto
  
  createdAt       DateTime                    @default(now())
  updateAt        DateTime    @updatedAt

  usuario     Usuario     @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  review      Review      @relation(fields: [id_review], references: [id], onDelete: Cascade)

  @@unique([id_usuario, id_review])
  @@index([id_usuario])
  @@index([id_review])
}

model Foto {
  id              Int         @id             @default(autoincrement())
  url             String
  id_review       Int        
  createdAt       DateTime    @default(now())
  review          Review      @relation(fields: [id_review], references: [id], onDelete: Cascade)

  @@index([id_review])
}

model Tag {
  id              Int         @id             @default(autoincrement())
  descritivo      String      @unique
  createdAt       DateTime                    @default(now())

  em_reviews      Tag_review[]
}

model Tag_review {
  id              Int         @id             @default(autoincrement())
  id_review       Int
  id_tag          Int

  review          Review      @relation(fields: [id_review], references: [id], onDelete: Cascade)
  tag             Tag         @relation(fields: [id_tag], references: [id], onDelete: Cascade)
}


model Token_redefinicao_senha {
  id            Int         @id             @default(autoincrement())
  token         String
  expira_em     DateTime
  usuario       Usuario     @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  id_usuario    Int
  
  @@index([id_usuario])
}

model Denuncia {
  id         Int        @id            @default(autoincrement())
  descricao  String
  createdAt  DateTime   @default(now())

  autor      Usuario    @relation(fields: [id_usuario], references: [id], onDelete: Cascade, onUpdate: Cascade)
  id_usuario Int

  review     Review     @relation(fields: [id_review], references: [id], onDelete: Cascade, onUpdate: Cascade)
  id_review  Int

  @@unique([id_usuario, id_review])
}

model Token_refresh {
  id          Int      @id @default(autoincrement())
  token_hash  String   @unique
  expira_em   DateTime
  usuario     Usuario  @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  id_usuario  Int

  @@index([id_usuario])
}

enum Role {
  USER
  ADM
}

enum Tipo_voto {
  LIKE
  DISLIKE
}